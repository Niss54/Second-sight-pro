# ============================================================
# [PROJECT NAME] — Environment Variables
# ============================================================
# 📋 Instructions:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all values marked with [REPLACE_THIS]
#   3. NEVER commit your .env file to git (it's in .gitignore)
#   4. For production, use your hosting platform's secret manager
#
# ❓ Need help?  See 06_DEPLOYMENT.md for details
# ============================================================

# ------------------------------------------------------------
# 🌍 APP CONFIG
# ------------------------------------------------------------

NODE_ENV=development
# Options: development | staging | production

APP_NAME=[Project Name]
APP_URL=http://localhost:3000
# Production: https://yourapp.com

API_URL=http://localhost:8000
# Production: https://api.yourapp.com

PORT=8000
# Backend server port

FRONTEND_PORT=3000
# Frontend server port

LOG_LEVEL=debug
# Options: error | warn | info | http | debug
# Production: use 'warn' or 'error'

# ------------------------------------------------------------
# 🔑 JWT AUTHENTICATION
# ------------------------------------------------------------

JWT_SECRET=[REPLACE_THIS]
# Generate: openssl rand -hex 64
# Min length: 64 characters
# Example: a3f8c2d1e9b4f7a2c5d8e1f4b7c0d3e6f9a2b5c8d1e4f7a0b3c6d9e2f5a8b1c4

JWT_REFRESH_SECRET=[REPLACE_THIS]
# Generate: openssl rand -hex 64
# Must be DIFFERENT from JWT_SECRET

JWT_ACCESS_EXPIRES=15m
# Access token expiry (short-lived for security)
# Options: 15m | 30m | 1h

JWT_REFRESH_EXPIRES=7d
# Refresh token expiry
# Options: 7d | 14d | 30d

# ------------------------------------------------------------
# 🗄️ DATABASE — PostgreSQL
# ------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/[project]_db
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Production: Use connection string from your DB provider

DB_HOST=localhost
DB_PORT=5432
DB_NAME=[project]_db
DB_USER=postgres
DB_PASSWORD=postgres
# Production: Use a strong random password!

DB_POOL_MIN=2
DB_POOL_MAX=10
# Connection pool limits

# For Prisma shadow database (migrations only)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/[project]_shadow_db

# ------------------------------------------------------------
# ⚡ REDIS — Cache & Sessions
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379
# Production: redis://:[PASSWORD]@[HOST]:6379

REDIS_PASSWORD=
# Leave empty for local dev. Set strong password in production.

REDIS_TTL=3600
# Default cache TTL in seconds (1 hour)

REDIS_SESSION_TTL=604800
# Session TTL in seconds (7 days)

# ------------------------------------------------------------
# 📧 EMAIL — Transactional Email
# ------------------------------------------------------------

# Provider: Choose ONE (Resend / SendGrid / SMTP)

# Option 1: Resend (recommended)
RESEND_API_KEY=[REPLACE_THIS]
# Get from: https://resend.com/api-keys

# Option 2: SendGrid
SENDGRID_API_KEY=[REPLACE_THIS]
# Get from: https://app.sendgrid.com/settings/api_keys

# Option 3: Generic SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=[REPLACE_THIS]
SMTP_PASS=[REPLACE_THIS]

# Sender config (all providers)
EMAIL_FROM_NAME=[Project Name]
EMAIL_FROM_ADDRESS=noreply@[yourproject].com
EMAIL_REPLY_TO=support@[yourproject].com

# ------------------------------------------------------------
# 📁 FILE STORAGE — AWS S3 / Cloudflare R2
# ------------------------------------------------------------

# Option 1: AWS S3
AWS_ACCESS_KEY_ID=[REPLACE_THIS]
AWS_SECRET_ACCESS_KEY=[REPLACE_THIS]
AWS_REGION=ap-south-1
AWS_S3_BUCKET=[project]-uploads

# Option 2: Cloudflare R2 (cheaper, S3 compatible)
CLOUDFLARE_ACCOUNT_ID=[REPLACE_THIS]
CLOUDFLARE_R2_ACCESS_KEY=[REPLACE_THIS]
CLOUDFLARE_R2_SECRET_KEY=[REPLACE_THIS]
CLOUDFLARE_R2_BUCKET=[project]-uploads
CLOUDFLARE_R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com

# Option 3: Cloudinary (images with auto-transform)
CLOUDINARY_CLOUD_NAME=[REPLACE_THIS]
CLOUDINARY_API_KEY=[REPLACE_THIS]
CLOUDINARY_API_SECRET=[REPLACE_THIS]

# CDN base URL for serving files
CDN_BASE_URL=https://cdn.[yourproject].com

# Upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ------------------------------------------------------------
# 🔐 OAUTH — Social Login (Optional)
# ------------------------------------------------------------

# Google OAuth
GOOGLE_CLIENT_ID=[REPLACE_THIS]
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=[REPLACE_THIS]
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=[REPLACE_THIS]
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_SECRET=[REPLACE_THIS]
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ------------------------------------------------------------
# 💳 PAYMENTS — Stripe (Optional)
# ------------------------------------------------------------

STRIPE_PUBLISHABLE_KEY=pk_test_[REPLACE_THIS]
# Get from: https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_[REPLACE_THIS]
# ⚠️ Keep this SECRET — never expose in frontend

STRIPE_WEBHOOK_SECRET=whsec_[REPLACE_THIS]
# Get from: https://dashboard.stripe.com/test/webhooks
# Used to verify webhook signatures

STRIPE_PRICE_ID_MONTHLY=price_[REPLACE_THIS]
STRIPE_PRICE_ID_YEARLY=price_[REPLACE_THIS]

# ------------------------------------------------------------
# 📊 MONITORING & ANALYTICS
# ------------------------------------------------------------

# Sentry — Error tracking
SENTRY_DSN=[REPLACE_THIS]
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# Production: 0.1 (10% sampling for performance)

# PostHog — Product analytics (privacy-friendly)
POSTHOG_API_KEY=[REPLACE_THIS]
# Get from: https://posthog.com
POSTHOG_HOST=https://app.posthog.com

# Datadog — Infrastructure monitoring (optional)
DD_API_KEY=[REPLACE_THIS]
DD_APP_KEY=[REPLACE_THIS]
DD_SERVICE_NAME=[project-name]

# ------------------------------------------------------------
# 🔒 SECURITY
# ------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000
# Production: https://yourapp.com,https://www.yourapp.com
# Multiple origins: comma-separated

COOKIE_DOMAIN=localhost
# Production: .yourapp.com (note the leading dot)

COOKIE_SECRET=[REPLACE_THIS]
# Generate: openssl rand -hex 32

BCRYPT_SALT_ROUNDS=12
# 10 = fast (dev), 12 = balanced (prod), 14 = slow but more secure

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------
# 🔔 NOTIFICATIONS (Optional)
# ------------------------------------------------------------

# Twilio — SMS
TWILIO_ACCOUNT_SID=[REPLACE_THIS]
TWILIO_AUTH_TOKEN=[REPLACE_THIS]
TWILIO_FROM_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=[REPLACE_THIS]
FIREBASE_PRIVATE_KEY=[REPLACE_THIS]
FIREBASE_CLIENT_EMAIL=[REPLACE_THIS]

# ------------------------------------------------------------
# 🧪 TESTING (use separate DB for tests!)
# ------------------------------------------------------------

TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/[project]_test_db
# Never use production DB for tests

TEST_REDIS_URL=redis://localhost:6380
# Use different Redis port or DB index for tests

# ------------------------------------------------------------
# ⚙️ MISC
# ------------------------------------------------------------

TIMEZONE=Asia/Kolkata
# Your server timezone

ADMIN_EMAIL=admin@[yourproject].com
# Initial admin account email

# Feature Flags (true/false)
FEATURE_GOOGLE_AUTH=false
FEATURE_GITHUB_AUTH=false
FEATURE_STRIPE_PAYMENTS=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_MAINTENANCE_MODE=false

# ============================================================
# 🚀 Quick Setup for Local Dev:
# ============================================================
# 1. cp .env.example .env
# 2. Generate JWT secrets:
#    openssl rand -hex 64   → paste into JWT_SECRET
#    openssl rand -hex 64   → paste into JWT_REFRESH_SECRET
#    openssl rand -hex 32   → paste into COOKIE_SECRET
# 3. docker compose up -d postgres redis
# 4. npx prisma migrate dev
# 5. npm run dev
# ============================================================
